{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 — Заполнить базу",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "seed.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "2 — Показать данные и связи",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "inspect_db.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "3 — Проверить ограничения",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "verify.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "4 — Открыть экран базы",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "streamlit",
        "run",
        "frontend/app.py",
        "--browser.gatherUsageStats",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "5 — Запустить FastAPI",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}